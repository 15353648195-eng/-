NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pdd_tool
DB_USER=postgres
DB_PASSWORD=your_password

# BitBrowser
BITBROWSER_API_URL=http://localhost:8008
BITBROWSER_API_KEY=your_api_key

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Log
LOG_LEVEL=debug
